}
```

### 2. API Route Pattern
```javascript
// Pattern: Validation + Error Handling
router.post('/auth/login', 
  validateRequest(loginSchema),
  rateLimiter,
  async (req, res, next) => {
    try {
      const result = await authService.authenticate(req.body);
      res.json({ success: true, data: result });
    } catch (error) {
      next(error);
    }
  }
);
```

### 3. Test Pattern
